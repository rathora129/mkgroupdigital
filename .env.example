# Contact form delivery.
# Without one of these configured, /api/contact returns an explicit
# "not configured" (503) response and the UI falls back to email / WhatsApp.
# No secrets are ever read on the client.
#
# Delivery priority: Resend is used when RESEND_API_KEY and CONTACT_FROM_EMAIL
# are both set. Otherwise CONTACT_WEBHOOK_URL is used.

# Send through Resend (https://resend.com). CONTACT_FROM_EMAIL must be a
# verified sender/domain in your Resend account.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=query@mkgroupdigital.com

# Or forward the validated lead to a webhook / automation endpoint.
CONTACT_WEBHOOK_URL=

